{
  "name": "ataraxia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:player": "vite --mode player",
    "build": "tsc --noEmit && vite build",
    "build:studio": "tsc --noEmit && vite build --mode studio",
    "verify:player-build": "npm run build && node scripts/verify-player-build.mjs",
    "preview": "vite preview",
    "preview:studio": "vite preview --mode studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "analyze": "node scripts/analyze.mjs",
    "calibrate": "node scripts/calibrate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "music-metadata": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "audio-decode": "^3.12.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "mpg123-decoder": "^1.0.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
